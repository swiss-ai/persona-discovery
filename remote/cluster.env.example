# remote/cluster.env.example -- copy to remote/cluster.env (gitignored) and adjust.
# The values below are a concrete example for the CSCS Alps/Clariden setup of the thesis; other systems must
# supply their own. Sourced by the remote/ scripts (bash); the scripts export what the jobs need.

# The repository checkout on the cluster: by default the checkout that contains this file.
PROJECT_ROOT_AT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Slurm account for the pipeline jobs and for the interactive node (remote/reserve_resources.sh).
# CSCS: infra01 is the recommended account for this setup (requires access to that allocation).
ACCOUNT=infra01

# Container image (.sqsh) built from swiss-ai/posttraining at commit 38c6036. CSCS: the thesis image
# (requires read access to this storage). Elsewhere: build the image and set its path.
CONTAINER_IMAGE=/capstor/store/cscs/swissai/infra01/swiss-alignment/container-images/swiss-alignment+apertus-vllm-38c6036.sqsh

# Weights & Biases entity and project of the probe-training runs (src/3_train_probes.py): your own.
WANDB_ENTITY="<wandb-entity>"
WANDB_PROJECT="<wandb-project>"

# Optional (defaults shown):
# EXTRA_MOUNTS=/path/a,/path/b                # further directories to mount into the container
# HF_TOKEN_AT=$HOME/.hf-token                 # file with the Hugging Face token
# WANDB_API_KEY_FILE_AT=$HOME/.wandb-api-key  # file with the W&B API key
# SCRATCH=/path/to/scratch                    # only if your cluster does not set $SCRATCH;
#                                             # data goes to $SCRATCH/apertus-pulse/data
